#include <winresrc.h>
#include "resource.h"

// first icon = exe icon
IDI_APP ICON "app.ico"
IDI_APP_OFF ICON "app_off.ico"

// manifest (id 1, type 24)
1 24 "app.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 240, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CtrlDtoBackspace Settings"
FONT 9, "Segoe UI"
BEGIN
  CONTROL "Enable keyboard remapping (CTRL + D = Backspace)", IDC_CHK_ENABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 14, 214, 12
  CONTROL "Start automatically with Windows", IDC_CHK_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 32, 214, 12
  CONTROL "Launch minimized to system tray", IDC_CHK_MINIMIZED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 50, 214, 12
  LTEXT "", IDC_STATUS, 14, 76, 214, 10
  LTEXT "", IDC_VERSION, 14, 90, 214, 10
  PUSHBUTTON "Exit application", IDC_BTN_EXIT, 14, 122, 80, 14
  DEFPUSHBUTTON "Close", IDOK, 148, 122, 80, 14
END

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "CtrlDtoBackspace"
      VALUE "FileVersion", APP_VERSION_STR
      VALUE "ProductName", "CtrlDtoBackspace"
      VALUE "ProductVersion", APP_VERSION_STR
      VALUE "OriginalFilename", "CtrlDtoBackspace.exe"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
